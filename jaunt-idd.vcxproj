<?xml version="1.0" encoding="utf-8"?>
<!-- jaunt's indirect display driver (UMDF 2, IddCx 1.4): built with the Windows Driver Kit
     (Visual Studio's or NuGet's). Modeled on Microsoft's IddSampleDriver.vcxproj (MIT, NOTICE.md).
     SPDX-License-Identifier: MIT -->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{5B2C3E7A-1F0D-4C55-9C3B-7A6D8E2F4B10}</ProjectGuid>
    <TemplateGuid>{32909489-7be5-497b-aafa-db6669d9b44b}</TemplateGuid>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>12.0</MinimumVisualStudioVersion>
    <Configuration>Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RootNamespace>JauntIdd</RootNamespace>
  </PropertyGroup>
  <!-- The WDK and SDK from NuGet (build.ps1 puts them in packages\ when the WDK is not installed). -->
  <Import Project="packages\*\build\native\*.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsUserModeDriver10.0</PlatformToolset>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <DriverType>UMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <UMDF_VERSION_MAJOR>2</UMDF_VERSION_MAJOR>
    <UMDF_VERSION_MINOR>25</UMDF_VERSION_MINOR>
    <!-- The WDK adds IddCx's headers (um\iddcx\<version>) and IddCxStub.lib only for this. -->
    <IndirectDisplayDriver>true</IndirectDisplayDriver>
    <IDDCX_VERSION_MAJOR>1</IDDCX_VERSION_MAJOR>
    <IDDCX_VERSION_MINOR>4</IDDCX_VERSION_MINOR>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>JauntIdd</TargetName>
    <EnableInf2cat>true</EnableInf2cat>
    <Inf2CatUseLocalTime>true</Inf2CatUseLocalTime>
    <!-- The release's version (build.ps1 -Version, from its tag): the DLL's version information and
         the INF's DriverVer. 0.0.1: a build that is not a release (Windows refuses 0.0.0.0). -->
    <JauntIddVersion Condition="'$(JauntIddVersion)' == ''">0.0.1</JauntIddVersion>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <WarningLevel>Level4</WarningLevel>
      <PreprocessorDefinitions>IDDCX_VERSION_MAJOR=1;IDDCX_VERSION_MINOR=4;IDDCX_MINIMUM_VERSION_REQUIRED=4;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);OneCoreUAP.lib;avrt.lib;d3d11.lib;dxgi.lib;ole32.lib;advapi32.lib</AdditionalDependencies>
    </Link>
    <ResourceCompile>
      <!-- jaunt-idd-version.h, written below. -->
      <AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
    <Inf>
      <TimeStamp>$(JauntIddVersion).0</TimeStamp>
    </Inf>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\driver.cpp" />
    <ClCompile Include="src\control.cpp" />
    <ClCompile Include="src\protocol.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\driver.h" />
    <ClInclude Include="src\protocol.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="src\jaunt-idd.rc" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="jaunt-idd.inf" />
  </ItemGroup>
  <!-- The version for src\jaunt-idd.rc: MAJOR.MINOR.PATCH only. -->
  <Target Name="JauntIddVersionHeader" BeforeTargets="ResourceCompile">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(JauntIddVersion)', '^[0-9]{1,5}\.[0-9]{1,5}\.[0-9]{1,5}$')) or '$(JauntIddVersion)' == '0.0.0'"
           Text="JauntIddVersion is MAJOR.MINOR.PATCH other than 0.0.0 (Windows refuses a driver version of 0.0.0.0), not '$(JauntIddVersion)'." />
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(IntDir)jaunt-idd-version.h" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="#define JAUNT_IDD_VERSION_COMMA $(JauntIddVersion.Replace('.', ',')),0;#define JAUNT_IDD_VERSION_STRING &quot;$(JauntIddVersion)&quot;" />
  </Target>
  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="packages\*\build\native\*.targets" />
</Project>
